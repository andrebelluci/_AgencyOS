# Agency OS — variáveis de ambiente
#
# Copie para .env.local e preencha os valores:
#   Copy-Item .env.example .env.local   (PowerShell)
#   cp .env.example .env.local          (bash)
#
# Guia completo: docs/SUPABASE_SETUP.md

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# URL pública do app (dev, preview ou produção)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Domínio da plataforma para resolução de subdomínio (opcional)
# PLATFORM_DOMAIN=agencyos.com.br

# Slug do tenant em hosts sem subdomínio (apex ou *.vercel.app)
# PLATFORM_APEX_TENANT_SLUG=development

# ---------------------------------------------------------------------------
# Widget (ISSUE-031A–031D) — defaults em tenant_settings ao provisionar
# ---------------------------------------------------------------------------
# initial_message suporta {{company_name}}
# quick_actions: JSON array no painel Settings
# primary_color: #RRGGBB — única cor do widget no V0.1

# ---------------------------------------------------------------------------
# Platform Admin (ISSUE-032 / #37)
# ---------------------------------------------------------------------------
# E-mails separados por vírgula com acesso a /admin
# PLATFORM_ADMIN_EMAILS=admin@agencyos.com.br

# ---------------------------------------------------------------------------
# Rate limit — API pública (ISSUE-033 / #38, opcional — defaults no código)
# ---------------------------------------------------------------------------
# RATE_LIMIT_IP_MAX=60
# RATE_LIMIT_IP_WINDOW_MS=60000
# RATE_LIMIT_KEY_MAX=30
# RATE_LIMIT_KEY_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# Supabase (ISSUE-002) — obrigatório para dev com banco/auth/storage
# Dashboard: Project Settings → API
# ---------------------------------------------------------------------------
# Project URL (ex.: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave anon/public — segura para o browser (RLS protege os dados)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role — APENAS servidor; nunca exponha no client
# Usada por scripts admin e operações que bypassam RLS
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Database — Drizzle (ISSUE-003) — obrigatório para db:migrate
# Dashboard: Project Settings → Database → Connection string (URI, pooler)
# Use modo Transaction (porta 6543) para serverless
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# OpenAI (ISSUE-014)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# E2E Playwright (tests/e2e/) — opcional; defaults do seed dev
# ---------------------------------------------------------------------------
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# E2E_PUBLIC_KEY=pk_dev_local
# E2E_OWNER_EMAIL=owner@belluci.dev
# E2E_OWNER_PASSWORD=BelluciDev2026!
# E2E_ASSISTANT_LABEL=Funcionário Digital
